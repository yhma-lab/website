@article{xiuhuaThermodynamicConstraintsHeat2023,
 abstract = {$<$p$>$To study thermodynamic constraints associated with finite-sized reservoirs in more general cases, a thermodynamic cycle between two reservoirs with finite and non-symmetrical heat capacities is proposed, assuming that heat capacities satisfy Debye law $<$inline-formula$>$ C\propto T\textasciicircumn $<$img text_id='M9' class='formula-img' style='display:none;' src='2023066_M9.jpg'$><$alternatives$><$/alternatives$><$/inline-formula$>$． Here, asymmetry of reservoirs is reflected in different power exponents $<$inline-formula$>$ n $<$img text_id='M10' class='formula-img' style='display:none;' src='2023066_M10.jpg'$><$alternatives$><$/alternatives$><$/inline-formula$>$ of heat capacity $<$inline-formula$>$ C $<$img text_id='M11' class='formula-img' style='display:none;' src='2023066_M11.jpg'$><$alternatives$><$/alternatives$><$/inline-formula$>$ with respect to temperature $<$inline-formula$>$ T $<$img text_id='M12' class='formula-img' style='display:none;' src='2023066_M12.jpg'$><$alternatives$><$/alternatives$><$/inline-formula$>$ of different reservoirs． For common solid materials, $<$inline-formula$>$ n $<$img text_id='M10' class='formula-img' style='display:none;' src='2023066_M10.jpg'$><$alternatives$><$/alternatives$><$/inline-formula$>$ is determined by spatial dimensionality of the material and temperature range it is in． In two limit regimes of $<$inline-formula$>$ \xi $<$img text_id='M14' class='formula-img' style='display:none;' src='2023066_M14.jpg'$><$alternatives$><$/alternatives$><$/inline-formula$>$ (defined as initial heat capacity ratio of low-temperature reservoir to high-temperature reservoir), i.e., $<$inline-formula$>$ \xi \to 0 $<$img text_id='M15' class='formula-img' style='display:none;' src='2023066_M15.jpg'$><$alternatives$><$/alternatives$><$/inline-formula$>$ and $<$inline-formula$>$ \xi \to \infty $<$img text_id='M16' class='formula-img' style='display:none;' src='2023066_M16.jpg'$><$alternatives$><$/alternatives$><$/inline-formula$>$, it is proved that efficiency at maximum power (EMP) as a function of efficiency at maximum work (EMW) has a universality that is independent of dimension of the reservoir． In addition, a special case where initial heat capacities of two heat reservoirs are symmetric in numerical value but their heat capacity behaviors (with respect to temperature) are not symmetric is numerically studied． EMW and EMP are found to increase with increased dimension of high-temperature reservoir, and their monotonic behavior with changed dimension of low-temperature reservoir depends on initial temperature ratio $<$inline-formula$>$ T_\mathrmL/T_\mathrmH $<$img text_id='M17' class='formula-img' style='display:none;' src='2023066_M17.jpg'$><$alternatives$><$/alternatives$><$/inline-formula$>$ of low- and high-temperature reservoirs． This finding suggests that if heat capacity properties of finite-sized reservoirs are incorporated into cycle optimization, optimization direction at low-temperature end (the choice of $<$inline-formula$>$ n $<$img text_id='M10' class='formula-img' style='display:none;' src='2023066_M10.jpg'$><$alternatives$><$/alternatives$><$/inline-formula$>$ in a given interval) should be determined by the initial Carnot efficiency $<$inline-formula$>$ \eta _\mathrmC\equiv 1-T_\mathrmL/T_\mathrmH $<$img text_id='M19' class='formula-img' style='display:none;' src='2023066_M19.jpg'$><$alternatives$><$/alternatives$><$/inline-formula$>$．$<$/p$>$},
 author = {Xiuhua, Zhao and Zhanchun, T. U. and Yuhan, M. A.},
 copyright = {http://creativecommons.org/licenses/by/3.0/},
 doi = {10.12202/j.0476-0301.2023066},
 issn = {0476-0301},
 journal = {Journal of Beijing Normal University(Natural Science)},
 langid = {chinese},
 month = {December},
 number = {6},
 pages = {969--978},
 publisher = {《北京师范大学学报（自然科学版）》编辑部},
 title = {Thermodynamic constraints on heat engine cycles between asymmetrical finite-sized reservoirs},
 urldate = {2025-07-10},
 volume = {59},
 year = {2023}
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "yhma-yyds-group typecheck",
  "extends": "../../tsconfig.react.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "./",
    "types": ["node", "vite/client", "@vitejs/plugin-rsc/types"]
  },
  "include": [
    ".source/**/*.ts",
    "source.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tsconfig.json",
    "waku.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}

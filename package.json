{
  "name": "yhma-group-websites",
  "version": "0.1.0",
  "private": true,
  "description": "Sites for Ma Research group",
  "keywords": [
    "sites"
  ],
  "license": "MIT",
  "author": "Lanqing Huang <lqhuang@outlook.com>",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive build",
    "build:cn": "pnpm --filter magroup-ac-cn build",
    "build:en": "pnpm --filter yhma-yyds-group build",
    "check:routes": "node scripts/check-route-parity.mjs",
    "content:codegen": "pnpm --recursive content:codegen",
    "dev": "pnpm --recursive --parallel dev",
    "dev:cn": "pnpm --filter magroup-ac-cn dev",
    "dev:en": "pnpm --filter yhma-yyds-group dev",
    "format": "prettier --write .",
    "knip": "knip",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json && pnpm --recursive typecheck",
    "typegen": "pnpm --recursive typegen"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.27.2",
    "@eslint/config-helpers": "^0.7.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@prettier/plugin-oxc": "^0.2.3",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "eslint-package-json": "^3.0.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-properties": "^0.3.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=26.12.1"
  }
}

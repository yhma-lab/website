{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Site typecheck",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /**
     * Modules
     *
     * Imports carry explicit `.ts`/`.tsx` extensions so the same specifiers work
     * for Vite and for Node's type stripping. Nothing is emitted, so the
     * extension rewriting that `rewriteRelativeImportExtensions` normally
     * performs is disabled: it rejects aliased paths such as `@/lib/site.ts`.
     */
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rewriteRelativeImportExtensions": false,
    /**
     * Emit
     *
     * The site is a static export, so this project is check-only: `waku build`
     * produces the artifacts and nothing needs declaration emit.
     */
    "noEmit": true,
    "rootDir": "./",
    /**
     * Language and Environment
     */
    "jsx": "react-jsx",
    "lib": ["ESNext", "ESNext.Temporal", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "@vitejs/plugin-rsc/types"]
  },
  "include": [
    ".source/**/*.ts",
    "scripts/**/*.mjs",
    "source.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.config.ts",
    "waku.config.ts"
  ],
  "exclude": ["node_modules", ".references", "dist"]
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Workspace tooling typecheck",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /**
     * Modules
     *
     * Only the root tooling is checked here: each workspace package has its own
     * `tsconfig.json` (extending `tsconfig.react.json`) and its own `typecheck`
     * script, which is what the root `pnpm typecheck` fans out to.
     */
    "module": "esnext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": false,
    "noEmit": true,
    "rootDir": "./",
    "lib": ["ESNext", "ESNext.Temporal"],
    "types": ["node"]
  },
  "include": ["scripts/**/*.mjs", "vitest.config.ts"],
  "exclude": ["node_modules", ".references", "dist"]
}

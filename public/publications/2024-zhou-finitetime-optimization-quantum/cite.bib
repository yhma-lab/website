@article{zhouFinitetimeOptimizationQuantum2024,
 abstract = {We propose a finite-time quantum Szilard engine (QSE) with a spin-1/2 quantum particle as the working substance (WS) to accelerate the operation of information engines. We introduce a Maxwell's demon (MD) to probe the spin state within a finite measurement time $t$M to capture the which-way information of the particle, quantified by the mutual information $I$⁡($tM$) between WS and MD. We establish that the efficiency $H$ of QSE is bounded by $Hłeq$1-(1-$HC$)⁢ln⁡2/⁢$I$⁡($t$M), where $I$⁡($tM$)/ln⁡2 characterizes the ideality of quantum measurement, and approaches 1 for the Carnot efficiency reached under ideal measurement in quasistatic regime. We find that the output power of QSE scales as $P$O$∝t$3$M$ in the short-time regime and as $P$O$∝t-$1$M$ in the long-time regime. Additionally, considering the energy cost for erasing the MD's memory required by Landauer's principle, there exists a threshold time that guarantees QSE to output positive work.},
 author = {Zhou, Tan-Ji and Ma, Yu-Han and Sun, C. P.},
 doi = {10.1103/PhysRevResearch.6.043001},
 journal = {Physical Review Research},
 month = {October},
 number = {4},
 pages = {043001},
 publisher = {American Physical Society},
 title = {Finite-Time Optimization of a Quantum Szilard Heat Engine},
 urldate = {2025-07-10},
 volume = {6},
 year = {2024}
}
